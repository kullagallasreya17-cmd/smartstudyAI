# ─── DATABASE ─────────────────────────────────────
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/smartstudy
POSTGRES_PASSWORD=your_postgres_password
REDIS_URL=redis://localhost:6379

# ─── AUTH ─────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── OAUTH ────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ─── AI ───────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key_fallback

# ─── VECTOR DB ────────────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=smartstudy-notes

# ─── STORAGE ──────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=ap-south-1
S3_BUCKET_NAME=smartstudy-uploads

# ─── EMAIL ────────────────────────────────────────
SENDGRID_API_KEY=your_sendgrid_key
EMAIL_FROM=noreply@smartstudy.ai

# ─── SERVICES ─────────────────────────────────────
BACKEND_PORT=4000
AI_SERVICE_PORT=8000
FRONTEND_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
